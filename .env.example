# Live Transcript Environment Configuration
# Copy this file to .env for local development

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LIVE_TRANSCRIPT_LOG_LEVEL=INFO

# Application storage location (leave empty to use default %LOCALAPPDATA%/LiveTranscript)
LIVE_TRANSCRIPT_DATA_DIR=

# Optional AI service keys (not required for local transcription)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
